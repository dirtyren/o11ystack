{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["headroom", "ai", "compression", "llm"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Headroom — Context Compression",
  "uid": "headroom",
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Runtime Tokens Saved",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "headroom_tokens_saved_total", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Lifetime Tokens Saved",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "headroom_persistent_savings_tokens_saved_total", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "headroom_requests_total", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Failed Requests",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "headroom_requests_failed_total", "refId": "A", "instant": true}]
    },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [{"expr": "rate(headroom_requests_total[5m])", "refId": "A", "legendFormat": "requests/s"}]
    },
    {
      "type": "timeseries",
      "title": "Tokens Saved Rate (tokens/s)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [{"expr": "rate(headroom_tokens_saved_total[5m])", "refId": "A", "legendFormat": "tokens saved/s"}]
    },
    {
      "type": "timeseries",
      "title": "Mean Request Latency (ms)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [{"expr": "rate(headroom_latency_ms_sum[5m]) / rate(headroom_latency_ms_count[5m])", "refId": "A", "legendFormat": "mean latency"}]
    },
    {
      "type": "timeseries",
      "title": "Mean Compression Overhead (ms)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [{"expr": "rate(headroom_overhead_ms_sum[5m]) / rate(headroom_overhead_ms_count[5m])", "refId": "A", "legendFormat": "mean overhead"}]
    },
    {
      "type": "timeseries",
      "title": "Semantic Cache Hit Rate",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [{"expr": "sum(rate(headroom_requests_cached_total[5m])) / sum(rate(headroom_requests_total[5m]))", "refId": "A", "legendFormat": "cache hit rate"}]
    },
    {
      "type": "timeseries",
      "title": "Failed Request Rate (req/s)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [{"expr": "rate(headroom_requests_failed_total[5m])", "refId": "A", "legendFormat": "failed/s"}]
    }
  ]
}
