{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["litellm", "ai", "llm", "gateway"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "LiteLLM — LLM Gateway",
  "uid": "litellm",
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(litellm_deployment_total_requests_total[5m]))", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Total Spend (USD)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(litellm_spend_metric_total)", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Total Tokens",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(litellm_total_tokens_metric_total)", "refId": "A", "instant": true}]
    },
    {
      "type": "stat",
      "title": "Cache Hit Ratio",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(litellm_cache_hits_metric_total[5m])) / (sum(rate(litellm_cache_hits_metric_total[5m])) + sum(rate(litellm_cache_misses_metric_total[5m])))", "refId": "A", "instant": true}]
    },
    {
      "type": "timeseries",
      "title": "Requests / s by Model",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [{"expr": "sum by (requested_model) (rate(litellm_deployment_total_requests_total[5m]))", "refId": "A", "legendFormat": "{{requested_model}}"}]
    },
    {
      "type": "timeseries",
      "title": "Success vs Failure",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {"expr": "sum(rate(litellm_deployment_success_responses_total[5m]))", "refId": "A", "legendFormat": "success"},
        {"expr": "sum(rate(litellm_deployment_failure_responses_total[5m]))", "refId": "B", "legendFormat": "failure"}
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 End-to-End Latency",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_request_total_latency_metric_bucket[5m])))", "refId": "A", "legendFormat": "p95 e2e"}]
    },
    {
      "type": "timeseries",
      "title": "p95 LLM Provider Latency",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_llm_api_latency_metric_bucket[5m])))", "refId": "A", "legendFormat": "p95 provider"}]
    },
    {
      "type": "timeseries",
      "title": "Tokens / s (input vs output)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"expr": "sum(rate(litellm_input_tokens_metric_total[5m]))", "refId": "A", "legendFormat": "input"},
        {"expr": "sum(rate(litellm_output_tokens_metric_total[5m]))", "refId": "B", "legendFormat": "output"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Spend Rate by Model (USD/s)",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "sum by (requested_model) (rate(litellm_spend_metric_total[5m]))", "refId": "A", "legendFormat": "{{requested_model}}"}]
    }
  ]
}
