# ==========================================
# Observability & AI Stack Configuration
# ==========================================

SERVER_HOST=neoson-o11y.duckdns.org
SERVER_PROTOCOL=https
HTTP_PORT=80
HTTPS_PORT=443

# DuckDNS Configuration
DUCKDNS_TOKEN=changeme_duckdns_token
DUCKDNS_SUBDOMAINS=neoson-o11y
DUCKDNS_DOMAIN=duckdns.org

# Storage Paths for Victoria Services (Retention: 1y)
VLOGS_DATA_PATH=/var/lib/vlogs
VMETRICS_DATA_PATH=/var/lib/vmetrics
VTRACES_DATA_PATH=/var/lib/vtraces

# Basic Auth for /vlogs, /vmetrics, /vtraces
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=changeme_basic_auth

# Grafana Administration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin

# MySQL Database for Grafana
MYSQL_ROOT_PASSWORD=changeme_mysql_root
GRAFANA_DB_PASSWORD=changeme_grafana_db

# PostgreSQL Database for LiteLLM
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme_postgres_litellm

# Redis In-Memory Cache for LiteLLM
REDIS_PASSWORD=changeme_redis

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-litellm-master-key-changeme
# Public base URL for LiteLLM (used by Web UI Playground & SDKs; must include protocol http/https)
PROXY_BASE_URL=https://neoson-o11y.duckdns.org/litellm

# Mezmo AURA SRE AI Agent
AURA_MODEL=deepseek-flash

# LLM Providers - Free Tier & Local (Provide one or more for live reasoning; mock-model is also available)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434

# LLM Providers - Commercial & Enterprise (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Grafana Service Account Token (Generated automatically by deploy.sh)
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ---------------------------------------------------------------------------
# Langfuse v4 (self-hosted LLM & MCP call tracing) — generate with:
#   openssl rand -hex 32   (NEXTAUTH_SECRET, ENCRYPTION_KEY)
#   openssl rand -hex 16   (passwords)
# and keystore keys pk-lf-.../sk-lf-... (any random hex string)
# ---------------------------------------------------------------------------
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_ORG_ID=o11ystack
LANGFUSE_INIT_ORG_NAME=o11ystack
LANGFUSE_INIT_PROJECT_ID=o11ystack
LANGFUSE_INIT_PROJECT_NAME=o11ystack
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# base64("pk:<secret key>") with a "Basic " prefix — used by the OTel collector's Langfuse exporter
LANGFUSE_OTLP_AUTH_HEADER=
# Langfuse UI login (password = LITELLM_MASTER_KEY by default, set in docker-compose.yml)
LANGFUSE_INIT_USER_EMAIL=admin@o11ystack.local
LANGFUSE_INIT_USER_NAME=admin
# Read-only ClickHouse user Grafana uses to query Langfuse traces/observations/scores
GRAFANA_LANGFUSE_DB_USER=grafana_langfuse
GRAFANA_LANGFUSE_DB_PASSWORD=


