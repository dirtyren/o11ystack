# ==========================================
# Observability & AI Stack Configuration
# ==========================================

# Server Host and Protocol
SERVER_HOST=localhost
SERVER_PROTOCOL=https
HTTP_PORT=80
HTTPS_PORT=443

# Storage Paths for Victoria Services (Retention: 1y)
VLOGS_DATA_PATH=/var/lib/vlogs
VMETRICS_DATA_PATH=/var/lib/vmetrics
VTRACES_DATA_PATH=/var/lib/vtraces

# Basic Auth for /vlogs, /vmetrics, /vtraces
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=changeme_basic_auth

# Grafana Administration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin

# MySQL Database for Grafana
MYSQL_ROOT_PASSWORD=changeme_mysql_root
GRAFANA_DB_PASSWORD=changeme_grafana_db

# PostgreSQL Database for LiteLLM
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme_postgres_litellm

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-litellm-master-key-changeme

# Mezmo AURA SRE AI Agent
AURA_MODEL=aura-sre-model

# LLM Providers (Optional - provide one or more for live LLM reasoning; mock-model is also available)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434

# Grafana Service Account Token (Generated automatically by deploy.sh)
GRAFANA_SERVICE_ACCOUNT_TOKEN=

